# Database (Docker locally, Neon.tech PostgreSQL URL in production)
DATABASE_URL="postgresql://bingo:bingo_dev_pass@localhost:5432/bingo_db?schema=public"

# Server
PORT=3001
NODE_ENV="development"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Telegram Bot & Branding (you can change Bot Name, Banner, Support dynamically in Admin too)
BOT_TOKEN=""
BOT_USERNAME=""
BOT_NAME="Bingo Ethiopia"
WELCOME_BANNER_URL=""
SUPPORT_USERNAME="@BingoSupport"
MINI_APP_URL="http://localhost:5173"
ADMIN_WEB_URL="http://localhost:5174"

# Initial Super Admin Seed
SUPER_ADMIN_TELEGRAM_ID="100000001"
SUPER_ADMIN_PHONE="+251900000000"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# Security
ADMIN_JWT_SECRET="replace-with-strong-64-char-random-secret"
ALLOW_DEV_AUTH="true"

