# Production Configuration
NODE_ENV="production"
PORT=3001

# Database (Handled automatically by docker-compose, or enter external Postgres URL)
DATABASE_URL="postgresql://bingo:bingo_secure_pass_2026@postgres:5432/bingo_db?schema=public"

# Telegram Bot
BOT_TOKEN="your_telegram_bot_token_here"
BOT_USERNAME="tunnel_bingo_bot"
BOT_NAME="Tunnel Bingo"
SUPPORT_USERNAME="@tunnel_tech_solution"

# Production Mini App Public Domain (Must start with https://)
MINI_APP_URL="https://yourdomain.com"
CORS_ORIGINS="https://yourdomain.com"

# Admin & Security
SUPER_ADMIN_TELEGRAM_ID="your_telegram_id_here"
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="YourStrongPasswordHere"
ADMIN_JWT_SECRET="generate_a_very_long_secure_secret_for_production"
ALLOW_DEV_AUTH="false"
